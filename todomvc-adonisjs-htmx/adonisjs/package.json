{
	"name": "todomvc",
	"version": "1.0.0",
	"description": "TodoMVC",
	"repository": {
		"type": "git",
		"url": "https://github.com/LetsZiggy/practices"
	},
	"private": true,
	"scripts": {
		"build": "node ace build --production",
		"dev": "node ace serve --watch",
		"fix:eslint": "pnpm exec eslint --config ./eslint.config.js --max-warnings 0 --no-warn-ignored --fix",
		"fix:prettier": "pnpm exec prettier --config ./prettier.config.js --write",
		"fix:stylelint": "pnpm exec stylelint --config ./stylelint.config.js --max-warnings 0 --fix",
		"preinstall": "npx only-allow pnpm",
		"start": "node server.js",
		"test": "node ace test"
	},
	"dependencies": {
		"@adonisjs/core": "^5.9.0",
		"@adonisjs/lucid": "^18.4.2",
		"@adonisjs/repl": "3.1.11",
