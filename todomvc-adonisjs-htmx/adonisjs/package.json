		"@adonisjs/shield": "^7.1.1",
		"@adonisjs/view": "^6.1.0",
		"@tool-belt/type-predicates": "^1.3.0",
		"html-minifier-terser": "^7.2.0",
		"htmx.org": "^1.9.12",
		"luxon": "^3.5.0",
		"pg": "^8.13.1",
		"proxy-addr": "^2.0.7",
		"reflect-metadata": "^0.2.2",
		"source-map-support": "^0.5.21",
		"todomvc-app-css": "^2.4.3",
		"todomvc-common": "^1.0.5"
	},
	"devDependencies": {
		"@adonisjs/assembler": "^5.9.6",
