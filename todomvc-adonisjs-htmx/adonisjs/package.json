		"eslint-plugin-unicorn": "^73.0.0",
		"fork-ts-checker-webpack-plugin": "^9.1.0",
		"pino-pretty": "^13.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-attributes": "^1.0.0",
		"prettier-plugin-pkg": "^0.22.1",
		"prettier-plugin-tsconfig": "github:LetsZiggy/prettier-plugin-tsconfig",
